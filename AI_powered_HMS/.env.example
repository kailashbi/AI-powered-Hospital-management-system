# KAIre Health Environment Variables Template
FLASK_ENV=production
PORT=5000
HOST=0.0.0.0
SECRET_KEY=your_production_secret_key
JWT_SECRET_KEY=your_production_jwt_secret_key
JWT_EXPIRES_HOURS=12

# Database Connection (MySQL or Supabase PostgreSQL)
USE_MYSQL=true
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_HOST_PORT=3307
MYSQL_USER=kaire_user
MYSQL_PASSWORD=your_secure_password
MYSQL_DB=kaire_health
DATABASE_URL=postgresql://postgres.xxx:yyy@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Apache Kafka Event Streaming (Local or Cloud Upstash Kafka / Confluent Cloud)
ENABLE_KAFKA=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Client Configuration
VITE_API_URL=https://kaire-health-api.onrender.com/api

